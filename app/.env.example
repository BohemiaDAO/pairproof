# Cluster the app talks to. "devnet" (default) or "localnet". mainnet-beta is not supported.
VITE_CLUSTER=devnet
# Optional RPC override (defaults to the public endpoint for the cluster).
# VITE_RPC_URL=https://api.devnet.solana.com
# Optional program id override (defaults to the id baked into the SDK's IDL).
# VITE_PROGRAM_ID=
